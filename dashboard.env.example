# Copy to dashboard.env; the real file is ignored by Git and Docker builds.
# API account: SELECT on fm_*; INSERT/UPDATE/DELETE on fm_overrides and fm_commands;
# INSERT on fm_audit. No DDL or shell/firewall privileges.
MYSQL_HOST=192.168.10.192
MYSQL_PORT=3306
MYSQL_DATABASE=dev
MYSQL_USER=firewall_dashboard
MYSQL_PASSWORD='replace-with-database-password'
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD='replace-with-at-least-12-characters'
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET='replace-with-a-random-secret-at-least-32-characters'
DASHBOARD_SESSION_HOURS=8
# Local HTTP via SSH tunnel: false; HTTPS deployment: true.
DASHBOARD_COOKIE_SECURE=false
EVENT_RETENTION_DAYS=30
