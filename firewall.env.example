# 示例配置；复制为 firewall.env 并填写密码。
# 脚本只读取进程环境，不会自动加载此文件。加载方法见 firewall.README.md。
MYSQL_HOST=192.168.10.192
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD='replace-with-your-password'
MYSQL_DATABASE=dev
MYSQL_CONNECT_TIMEOUT=10

FIREWALL_CONTAINER=frps
FIREWALL_ALLOWED_CITIES='郑州,周口,上海,南京'
FIREWALL_EXEMPT_SERVICES='http_30282,Home.sd_api,Home.Api_test,Home.sd_api2'
FIREWALL_BAN_LOG=/var/log/firewall-ban.log
# 可选：默认写到脚本所在目录下的 log/firewall.log。
# FIREWALL_LOG_DIR=/var/log/firewall-monitor
FIREWALL_HTTP_TIMEOUT=10
FIREWALL_GEO_TTL=86400
FIREWALL_RETRY_DELAY=5

# No / bark / pushplus_bot
FIREWALL_PUSH_MODE=No
# Bark 的完整推送 URL（包含你的设备令牌）
BARK_URL=''
PUSHPLUS_TOKEN=''
